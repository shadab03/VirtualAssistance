# =============================================================================
# JobFinderAI Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Telegram Bot ---
# Get from @BotFather on Telegram: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- OpenAI ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- SerpApi (Google Jobs) ---
# Get from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# --- Database ---
# Neon PostgreSQL (free): https://neon.tech
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
# For local dev, use SQLite: sqlite+aiosqlite:///./data/jobfinder.db
DATABASE_URL=sqlite+aiosqlite:///./data/jobfinder.db

# --- Security ---
# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID: message @userinfobot on Telegram
ALLOWED_USER_IDS=

# --- Job Search Defaults ---
DEFAULT_REGIONS=Saudi Arabia,United Arab Emirates
DEFAULT_ROLES=SAP ABAP Consultant,SAP MM Consultant,SAP EWM Consultant,Solution Architect

# --- Scheduler ---
# How often to check for new jobs (in minutes)
SCRAPE_INTERVAL_MINUTES=60
# Minimum match score to trigger a notification (1-10)
MIN_MATCH_SCORE=7

# --- Logging ---
LOG_LEVEL=INFO
